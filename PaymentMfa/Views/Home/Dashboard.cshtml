@model PaymentMfa.Models.DashboardModelo

<header class="encabezado">
    <div>
        <p class="etiqueta">Flotas</p>
        <h1>Bienvenido a Flotas</h1>
        <p class="detalle">Hola, <strong>@Model.Nombre</strong>. Acceso protegido con Microsoft Entra External ID.</p>
    </div>
    <form method="post" action="~/Cuenta/Salir">
        @Html.AntiForgeryToken()
        <button type="submit" class="boton secundario">Cerrar sesión</button>
    </form>
</header>

@if (Model.Grupos.Count > 0)
{
    <section class="grupos hay-grupos">
        <strong>Groups</strong>
        @foreach (var grupo in Model.Grupos)
        {
            <code class="grupo">@grupo</code>
        }
    </section>
}
else
{
    <section class="grupos">
        <strong>Groups</strong>
        <span class="detalle">No viene en el token</span>
    </section>
}

@if (!string.IsNullOrEmpty(Model.Permisos))
{
    <section class="grupos hay-grupos">
        <strong>Permisos</strong>
        <code class="grupo">@Model.Permisos</code>
    </section>
}
else
{
    @* Por ahora se deja entrar sin permisos; en producción este usuario debe quedar bloqueado *@
    <section class="grupos sin-permisos" role="alert">
        <strong>Permisos</strong>
        <span class="etiqueta-alerta">Sin permisos</span>
        <span>Este usuario no tiene un Id de permisos asociado. En producción no podrá ingresar sin permisos.</span>
    </section>
}

<div class="rejilla">
    <section class="tarjeta">
        <h2>Verificaciones de la sesión</h2>
        <ul class="lista">
            @foreach (var verificacion in Model.Verificaciones)
            {
                <li>
                    <span class="badge @verificacion.Estado">@verificacion.Etiqueta</span>
                    <div>
                        <div>@verificacion.Nombre</div>
                        <div class="detalle">@verificacion.Detalle</div>
                    </div>
                </li>
            }
        </ul>
    </section>

    <section class="tarjeta">
        <h2>Datos de la sesión</h2>
        <dl class="datos">
            <dt>Usuario</dt>
            <dd>@Model.Usuario</dd>
            <dt>Métodos (amr)</dt>
            <dd>@Model.Metodos</dd>
            <dt>Inicio de sesión</dt>
            <dd>@Model.InicioSesion</dd>
            <dt>Sesión expira</dt>
            <dd>@Model.SesionExpira</dd>
            <dt>ID de usuario</dt>
            <dd><code>@Model.Oid</code></dd>
        </dl>
    </section>
</div>

<section class="tarjeta">
    <details>
        <summary>Claims del ID token (@Model.Claims.Count)</summary>
        <dl class="datos">
            @foreach (var claim in Model.Claims)
            {
                <dt class="@claim.Clase"><code>@claim.Tipo</code></dt>
                <dd class="@claim.Clase">@claim.Valor</dd>
            }
        </dl>
    </details>
</section>
