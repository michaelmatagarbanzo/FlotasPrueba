<p class="etiqueta">Flotas</p>
<h1>Prueba de MFA en .NET Framework 4.8</h1>
@if (PaymentMfa.Startup.EntraConfigurada)
{
    <p>Esta página es pública. Para ver el dashboard debes iniciar sesión y completar el segundo factor.</p>
    <p class="acciones">
        <a class="boton" href="~/Cuenta/Entrar">Iniciar sesión</a>
        <a class="boton secundario" href="~/Cuenta/Registrarse">Crear cuenta</a>
        <a class="boton secundario" href="~/Home/Dashboard">Ir al dashboard</a>
    </p>
}
else
{
    <p>La aplicación está corriendo. El inicio de sesión se activará cuando se configure Microsoft Entra.</p>
}
